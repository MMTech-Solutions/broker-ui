# broker-service base URL (Laravel)
BROKER_SERVICE_URL=http://localhost:8000

# API prefix exposed by broker-service routes/api.php
BROKER_API_PREFIX=/api/broker

# MMT Trading Stream gateway (HTTP is used by the server-side subscription BFF).
TRADING_STREAM_URL=http://localhost:8081
# Browser WebSocket endpoint. Leave unset to disable the Live positions tab.
# NEXT_PUBLIC_TRADING_STREAM_WS_URL=ws://localhost:8081/api/broker/v1/stream

# IAM / Auth BFF (MMT-AUTH-SERVICE)
# Direct: http://localhost:8000/api/iam/v1
# Via gateway: https://your-apicore/api/iam/v1
IAM_API_BASE=http://localhost:8000/api/iam/v1

SESSION_SECRET=broker-ui-dev-secret-change-me
# SESSION_MAX_AGE_SECONDS=2592000

# Gateway headers required by mmtech/iam-rbac middleware
RBAC_GATEWAY_INTERNAL_HEADER=X-Internal-Gateway
RBAC_GATEWAY_INTERNAL_SECRET=apisix
RBAC_GATEWAY_USERINFO_HEADER=X-Userinfo

# Reverb (live risk metrics). Leave unset to disable WebSocket client.
# NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
# NEXT_PUBLIC_REVERB_HOST=localhost
# NEXT_PUBLIC_REVERB_PORT=8081
# NEXT_PUBLIC_REVERB_SCHEME=http
# Optional gateway prefix (mirrors prop-firm). Empty = /app/{key}.
# NEXT_PUBLIC_REVERB_PATH=/api/broker/v1/broadcasting
